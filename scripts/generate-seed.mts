// Regenerates supabase/seed.sql from the placeholder catalog in src/lib/demo-data.ts.
// Run with: node scripts/generate-seed.mts   (Node 22.18+ runs TypeScript directly)
import { writeFileSync } from "node:fs";
import { DEMO_CATEGORIES, DEMO_PRODUCTS, DEMO_SETTINGS } from "../src/lib/demo-data.ts";

const q = (v: string | null) => (v === null ? "null" : `'${v.replace(/'/g, "''")}'`);
const arr = (a: string[]) => `array[${a.map(q).join(",")}]::text[]`;

let sql = `-- Placeholder catalog for ausm (generated by scripts/generate-seed.mts).
-- Safe to run once after schema.sql. Delete or edit products later in the admin panel.

update public.store_settings set
  store_name = ${q(DEMO_SETTINGS.store_name)},
  whatsapp = ${q(DEMO_SETTINGS.whatsapp)},
  email = ${q(DEMO_SETTINGS.email)},
  bkash_number = ${q(DEMO_SETTINGS.bkash_number)},
  nagad_number = ${q(DEMO_SETTINGS.nagad_number)},
  delivery_inside_dhaka = ${DEMO_SETTINGS.delivery_inside_dhaka},
  delivery_outside_dhaka = ${DEMO_SETTINGS.delivery_outside_dhaka},
  free_delivery_over = ${DEMO_SETTINGS.free_delivery_over ?? "null"},
  announcement = ${q(DEMO_SETTINGS.announcement)}
where id = 1;

insert into public.categories (name, slug, group_name, sort_order) values
${DEMO_CATEGORIES.map((c) => `  (${q(c.name)}, ${q(c.slug)}, ${q(c.group_name)}, ${c.sort_order})`).join(",\n")}
on conflict (slug) do nothing;

`;

for (const p of DEMO_PRODUCTS) {
  sql += `with p as (
  insert into public.products (name, slug, description, category_id, price, compare_at_price, tags, featured)
  select ${q(p.name)}, ${q(p.slug)}, ${q(p.description)}, c.id, ${p.price}, ${p.compare_at_price ?? "null"}, ${arr(p.tags)}, ${p.featured}
  from public.categories c where c.slug = ${q(p.category!.slug)}
  on conflict (slug) do nothing
  returning id
)
insert into public.variants (product_id, name, stock, sort_order)
select p.id, v.name, v.stock, v.sort_order from p, (values
${p.variants.map((v) => `  (${q(v.name)}, ${v.stock}, ${v.sort_order})`).join(",\n")}
) as v(name, stock, sort_order);

`;
}

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote seed.sql with ${DEMO_CATEGORIES.length} categories and ${DEMO_PRODUCTS.length} products`);
