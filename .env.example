# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# --- Supabase (required to go live; without these the site runs in demo mode) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Site URL (used for social share previews) ---
NEXT_PUBLIC_SITE_URL=https://www.ausm.com.bd

# --- Optional: email a copy of every new order (https://resend.com, free tier) ---
# RESEND_API_KEY=re_xxxxxxxx
# ORDER_NOTIFY_EMAIL=orders@ausm.com.bd
# ORDER_FROM_EMAIL=ausm orders <orders@ausm.com.bd>
